# Copia este archivo como .env y rellena lo que uses (nunca subas .env al repositorio).
# iniciar.bat / iniciar.command lo copian automáticamente la primera vez.
PORT=3000
HOST=127.0.0.1

# StreamElements: Dashboard → tu avatar → Account → Channels → "Show secrets" → JWT Token
STREAMELEMENTS_JWT=
# Streamlabs: Dashboard → Settings → API Settings → API Tokens → "Your Socket API Token"
STREAMLABS_SOCKET_TOKEN=

# Una sola fuente para bits y subs (evita contarlos dos veces si conectas ambos servicios).
# Valores: streamelements | streamlabs | twitch | any. Vacío = el primero configurado (Twitch > StreamElements > Streamlabs).
BITS_FROM=
SUBS_FROM=
# Fuentes de donaciones (lista separada por comas). Son sistemas de pago distintos: no se duplican entre sí.
DONATIONS_FROM=streamelements,streamlabs,kofi

# Diagnóstico: DEBUG=1 muestra más detalle; SAVE_PAYLOADS=1 guarda los eventos reales en payloads.jsonl
DEBUG=0
SAVE_PAYLOADS=0

# Ko-fi: ko-fi.com → Settings → More → API → Webhooks → "Verification Token".
# Con token, el relay abre un puerto SOLO para el webhook (KOFI_PORT); apunta ahí tu túnel HTTPS (ver README).
KOFI_VERIFICATION_TOKEN=
KOFI_PORT=3001
# Tipos de Ko-fi que suman: donation, subscription, shop order, commission
KOFI_TYPES=donation,subscription

# Twitch EventSub (bits, subs, regalos, seguidores, raids): registra una app en dev.twitch.tv/console/apps,
# pon aquí su Client ID y conecta desde el panel (/control/twitch.html). El token se guarda en twitch-token.json.
TWITCH_CLIENT_ID=
# Opcional: token de usuario pegado a mano (scopes bits:read channel:read:subscriptions moderator:read:followers)
TWITCH_ACCESS_TOKEN=

# Comandos de chat (solo moderadores y tú): !meta add 5 [nombre] · !meta quitar 5 · !meta set 600 · !meta titulo TEXTO
# · !meta deshacer · !meta celebrar · !meta reset (solo el streamer). Lee el chat de forma anónima: no necesita token.
CHAT_COMMANDS=0
# Canal a escuchar. Vacío = el de la cuenta conectada en "Conectar Twitch".
TWITCH_CHANNEL=
CHAT_PREFIX=!meta
# Quién puede usarlos: broadcaster | mods | vips
CHAT_ALLOW=mods
